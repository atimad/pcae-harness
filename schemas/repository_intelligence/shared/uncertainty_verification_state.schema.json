{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcae.local/schemas/repository_intelligence/shared/uncertainty_verification_state.schema.json",
  "title": "Repository Intelligence Uncertainty / Verification State",
  "description": "Shared structural vocabulary for Repository Intelligence uncertainty and verification states. This schema records declared state values and rationale only; it does not decide, execute, mutate, or replace Decision Evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_value",
    "state_reason",
    "supporting_sources",
    "state_limitations",
    "timestamp_or_snapshot_context"
  ],
  "properties": {
    "state_value": {
      "$ref": "#/$defs/state_value"
    },
    "state_reason": {
      "type": "string",
      "minLength": 1
    },
    "supporting_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_reference"
      }
    },
    "state_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timestamp_or_snapshot_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_type",
        "context_value"
      ],
      "properties": {
        "context_type": {
          "type": "string",
          "enum": [
            "timestamp_utc",
            "commit",
            "phase",
            "release",
            "snapshot",
            "unknown"
          ]
        },
        "context_value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification_method": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_or_producer": {
      "$ref": "#/$defs/producer"
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "state_value": {
      "type": "string",
      "enum": [
        "known",
        "unknown",
        "unverified",
        "partially_verified",
        "weak",
        "possible",
        "inferred",
        "advisory_only",
        "decision_required",
        "verified",
        "invalid",
        "stale",
        "superseded",
        "conflicting"
      ]
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "repository_intelligence_package",
        "repository_knowledge_snapshot",
        "historical_memory_snapshot",
        "dependency_knowledge_graph_snapshot",
        "change_impact_report",
        "advisory_intelligence_context_package",
        "source_attribution_record",
        "evidence_link_record",
        "uncertainty_verification_state",
        "conflict_supersession_record",
        "query_result",
        "contract_conformance_record"
      ]
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_artifact_id",
        "ref_artifact_type",
        "ref_relationship"
      ],
      "properties": {
        "ref_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "ref_artifact_type": {
          "$ref": "#/$defs/artifact_type"
        },
        "ref_relationship": {
          "type": "string",
          "enum": [
            "contains",
            "references",
            "depends_on",
            "derived_from",
            "supersedes",
            "documents",
            "verifies",
            "packages",
            "context_for"
          ]
        },
        "ref_materialization_state": {
          "type": "string",
          "enum": [
            "materialized",
            "pending",
            "not_yet_materialized"
          ]
        },
        "ref_description": {
          "type": "string"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_type",
        "producer_identity"
      ],
      "properties": {
        "producer_type": {
          "type": "string",
          "enum": [
            "human",
            "phase",
            "tool",
            "skill",
            "extractor",
            "unknown"
          ]
        },
        "producer_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
