{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcae.local/schemas/repository_intelligence/shared/source_attribution_record.schema.json",
  "title": "Repository Intelligence Source Attribution Record",
  "description": "Shared structural source attribution record. It identifies and classifies declared sources only; it does not validate source truth, sufficiency, completeness, or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_type",
    "source_locator",
    "source_claim_relationship",
    "source_support_level",
    "source_verification_state",
    "source_staleness_state",
    "source_limitations"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "file",
        "commit",
        "phase_report",
        "task_contract",
        "decision_record",
        "evidence_record",
        "release_tag",
        "architecture_document",
        "contract_document",
        "test_file",
        "configuration_file",
        "dependency_manifest",
        "lifecycle_artifact"
      ]
    },
    "source_locator": {
      "$ref": "#/$defs/source_locator"
    },
    "source_claim_relationship": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts",
        "supersedes",
        "documents",
        "constrains",
        "verifies",
        "references",
        "introduces",
        "modifies",
        "hardens"
      ]
    },
    "source_support_level": {
      "type": "string",
      "enum": [
        "direct",
        "indirect",
        "implied",
        "weak",
        "contextual",
        "historical"
      ]
    },
    "source_verification_state": {
      "$ref": "./uncertainty_verification_state.schema.json#/$defs/state_value"
    },
    "source_staleness_state": {
      "type": "string",
      "enum": [
        "current",
        "stale_since_commit",
        "stale_since_phase",
        "superseded",
        "unknown"
      ]
    },
    "source_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_path": {
      "type": "string"
    },
    "source_digest_or_commit_reference": {
      "type": "string"
    }
  },
  "$defs": {
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_type",
        "locator_value"
      ],
      "properties": {
        "locator_type": {
          "type": "string",
          "enum": [
            "file_path",
            "file_path_line",
            "file_path_symbol",
            "file_path_section",
            "phase_id",
            "phase_report_id",
            "task_id",
            "commit_sha",
            "tag",
            "release_id",
            "evidence_id",
            "decision_id",
            "contract_document_section",
            "canonical_report_id"
          ]
        },
        "locator_value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
