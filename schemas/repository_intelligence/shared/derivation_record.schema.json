{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcae.local/schemas/repository_intelligence/shared/derivation_record.schema.json",
  "title": "Repository Intelligence Derivation Record",
  "description": "Shared structural derivation disclosure. It records declared methods, inputs, producers, and limitations only; it does not validate derivation correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "derivation_method",
    "derivation_inputs",
    "determinism_marker",
    "limitations",
    "producer_reference"
  ],
  "properties": {
    "derivation_method": {
      "type": "string",
      "minLength": 1
    },
    "derivation_inputs": {
      "type": "array",
      "items": {
        "$ref": "./uncertainty_verification_state.schema.json#/$defs/artifact_reference"
      }
    },
    "derivation_timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "determinism_marker": {
      "type": "string",
      "enum": [
        "deterministic",
        "non_deterministic",
        "mixed",
        "unknown"
      ]
    },
    "derivation_rule_family": {
      "type": "string"
    },
    "derivation_tool": {
      "$ref": "./uncertainty_verification_state.schema.json#/$defs/producer"
    },
    "derivation_nondeterminism_exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./limitation_record.schema.json"
      }
    },
    "producer_reference": {
      "$ref": "./uncertainty_verification_state.schema.json#/$defs/producer"
    }
  }
}
